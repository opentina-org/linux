#include "sun60i-a733.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "allwinner,a733-demo-aiot", "allwinner,a733";
	model = "Allwinner A733 Demo AIOT";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_3v3: regulator-fixed-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};
};

&mmc0 {
	/* Missing v(q)mmc-supply which is SWOUT2/CLDO3 of AXP318 */
	bus-width = <4>;
	disable-wp;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_3v3>;
	status = "okay";
};

&uart0 {
	status = "okay";
};

/*
 * IOMMU (sunxi-iommu): enable controller.
 * Second cell of iommus: 1 = enable translation, 0 = bypass.
 * USB/VE master bindings can be added when those DT nodes exist.
 */
&mmu_aw {
	status = "okay";

	usb_iommu {
		iommu-master;
		id = <0>;
	};

	dummy04 {
		iommu-master;
		id = <4>;
		skip;
	};

	dummy05 {
		iommu-master;
		id = <5>;
		skip;
	};
};

&gpadc0 {
	status = "okay";
};

&lradc {
	status = "okay";
	key_debounce;
	debounce_value = <50>;
	key_cnt = <1>;
	key0 = <500 116>; /* voltage(mV), KEY_POWER — adjust per schematic */
	filter-cnt = <3>;
};
