#include "sun60i-a733.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/usb/pd.h>

/ {
	compatible = "allwinner,a733-demo-aiot", "allwinner,a733";
	model = "Allwinner A733 Demo AIOT";

	aliases {
		serial0 = &uart0;
		pwm0 = &pwm0;
		spi0 = &spi0;
	};

	chosen {
		bootargs = "earlycon regulator_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	reg_5v: regulator-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "VCC5V0_SYS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	/* Type-C VBUS switch (Tina: PL5) */
	reg_usb0_vbus: usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb0-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&r_pio 0 5 GPIO_ACTIVE_HIGH>; /* PL5 */
		enable-active-high;
	};

	sound_i2s0: sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sunxi-i2s0";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&sound_i2s0_cpu>;
		simple-audio-card,frame-master = <&sound_i2s0_cpu>;
		simple-audio-card,mclk-fs = <256>;

		sound_i2s0_cpu: simple-audio-card,cpu {
			sound-dai = <&i2s0>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec>;
		};
	};

	dmic_codec: dmic-codec {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <2>;
	};

	sound_dmic: sound-dmic {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sunxi-dmic";

		simple-audio-card,cpu {
			sound-dai = <&dmic>;
		};

		simple-audio-card,codec {
			sound-dai = <&dmic_codec>;
		};
	};

	/*
	 * AMP / remoteproc / rpmsg shared memory (layout aligned with Tina
	 * sun60iw2 / a537 demo_aiot). Keep these regions below DRAM end.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * Name must be "vdev%dbuffer".
		 * Size >= RPMSG_BUF_SIZE * (vring buffers) * 2
		 *       = 512 * N * 2
		 */
		a55_vdev0buffer: vdev0buffer@4ae00000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x4ae00000 0x0 0x40000>;
			no-map;
		};

		/*
		 * Name must be "vdev%dvring%d".
		 * See virtio_ring layout in include/uapi/linux/virtio_ring.h.
		 */
		a55_vdev0vring0: vdev0vring0@4ae40000 {
			reg = <0x0 0x4ae40000 0x0 0x2000>;
			no-map;
		};

		a55_vdev0vring1: vdev0vring1@4ae42000 {
			reg = <0x0 0x4ae42000 0x0 0x2000>;
			no-map;
		};

		/* Loader places AMP ELF here (boot0/U-Boot or kernel mem-fw). */
		a55_mem_fw: a55_mem_fw@50000000 {
			reg = <0x0 0x50000000 0x0 0x00100000>;
		};

		/* Isolated AMP DRAM (entry / runtime). */
		a55_reserved: a55_ddr@51000000 {
			reg = <0x0 0x51000000 0x0 0x00a00000>;
			no-map;
		};
	};

	/* Property bag for sunxi_rproc_arm_boot (cpu-id / entry / load). */
	sunxi_amp: sunxi-amp {
		compatible = "sunxi,amp";
		status = "okay";
		amp-count = <1>;

		amp0: amp0 {
			/* cpu7 @ MPIDR 0x700 (A76) */
			cpu-id = <0x700>;
			entry-addr = <0x51000000>;
			load-addr = <0x50000000>;
			arch = <1>; /* 0: arm, 1: arm64 */
			image = "amp-arm";
			boot-stage = "kernel";
		};
	};
};

&gmac {
	assigned-clocks = <&ccu CLK_GMAC0_PHY>;
	assigned-clock-rates = <25000000>;
	tx-internal-delay-ps = <1000>;
	rx-internal-delay-ps = <2000>;
	phy-mode = "rgmii";
	phy-handle = <&rgmii_phy>;
	status = "okay";
};

&mdio {
	status = "okay";

	rgmii_phy: phy@1 {
		compatible = "ethernet-phy-id001c.c916",
			     "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		assigned-clocks = <&ccu CLK_GMAC0_PHY>;
		assigned-clock-rates = <25000000>;
		clocks = <&ccu CLK_GMAC0_PHY>;
		reset-gpios = <&pio 7 16 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <30000>;
	};
};

&mmc0 {
	bus-width = <4>;
	disable-wp;
	/* Poll: first CD IRQ is easy to miss next to UFS; card is the rootfs. */
	broken-cd;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;
	/* DC1SW2 gates 3.3V card power; I/O is also 3.3V (not CLDO5 1.8V). */
	vmmc-supply = <&swout2>;
	vqmmc-supply = <&swout2>;
	status = "okay";
};

&pio {
	/* PF = SD, PB = UART0, PG = Wi-Fi (DCDC1 3.3V) */
	vcc-pf-supply = <&swout2>;
	vcc-pb-supply = <&dcdc1>;
	vcc-pg-supply = <&dcdc1>;

	uart0_pins: uart0_pins {
		pins = "PB9", "PB10";
		function = "uart0";
		allwinner,pinmux = <2>;
		drive-strength = <10>;
	};

	pwm0_0_active: pwm0_0_active {
		pins = "PD0";
		function = "pwm0_0";
		allwinner,pinmux = <7>;
		drive-strength = <10>;
		bias-disable;
	};

	pwm0_0_sleep: pwm0_0_sleep {
		pins = "PD0";
		function = "gpio_in";
		allwinner,pinmux = <0>;
		bias-pull-down;
	};
};

&r_pio {
	s_i2c0_pins: s_i2c0_pins {
		pins = "PL0", "PL1";
		function = "s_twi0";
		allwinner,pinmux = <2>;
		drive-strength = <10>;
	};
};

&s_i2c0 {
	pinctrl-0 = <&s_i2c0_pins>;
	pinctrl-names = "default";
	status = "okay";

	axp318: pmic@36 {
		compatible = "x-powers,axp318w";
		reg = <0x36>;
		interrupt-parent = <&nmi_intc>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		#interrupt-cells = <1>;
		interrupt-controller;
		wakeup-source;

		vin19-supply = <&reg_5v>;
		vin23-supply = <&reg_5v>;
		vin45-supply = <&reg_5v>;
		vin678-supply = <&reg_5v>;
		dldoin-supply = <&reg_5v>;
		cldoin-supply = <&reg_5v>;
		swin-supply = <&reg_5v>;

		regulators {
			/* System fabric */
			reg_dcdc2: dcdc2 {
				regulator-name = "vdd-sys";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* A76 / big cluster */
			reg_dcdc3: dcdc3 {
				regulator-name = "vdd-cpub";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <25000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* A55 / little cluster */
			reg_dcdc5: dcdc5 {
				regulator-name = "vdd-cpul";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <25000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* IO / MMC I/O */
			cldo5: cldo5 {
				regulator-name = "cldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};
			/*
			 * DC1SW2: load switch on DCDC1. Driver reports a
			 * fixed 3.3V so MMC can build an OCR mask; enable
			 * only (no programmable vsel).
			 */
			swout2: swout2 {
				regulator-name = "swout2";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* Always-on rails kept enabled by firmware / board */
			dcdc1: dcdc1 {
				regulator-name = "dcdc1";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			dcdc4: dcdc4 {
				regulator-name = "dcdc4";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1540000>;
				regulator-boot-on;
				regulator-always-on;
			};

			dcdc6: dcdc6 {
				regulator-name = "dcdc6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <2760000>;
				regulator-boot-on;
				regulator-always-on;
			};

			dcdc8: dcdc8 {
				regulator-name = "dcdc8";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			dldo6: dldo6 {
				regulator-name = "dldo6";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};

	/*
	 * Hynetek HUSB311 Type-C / PD controller (RT1711H-compatible).
	 * Tina board: s_twi0 @0x4e, IRQ on PL10, VBUS on PL5.
	 * DP altmode / USB role-switch wiring deferred until USBDP PHY is ported.
	 */
	husb311: typec@4e {
		compatible = "hynetek,husb311", "richtek,rt1711h";
		reg = <0x4e>;
		interrupt-parent = <&r_pio>;
		interrupts = <0 10 IRQ_TYPE_LEVEL_LOW>; /* PL10 */
		vbus-supply = <&reg_usb0_vbus>;
		wakeup-source;
		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			source-pdos =
				<PDO_FIXED(5000, 500,
					   PDO_FIXED_DUAL_ROLE | PDO_FIXED_DATA_SWAP)>;
			sink-pdos =
				<PDO_FIXED(5000, 500,
					   PDO_FIXED_DUAL_ROLE | PDO_FIXED_DATA_SWAP)
				 PDO_VAR(5000, 5000, 2000)>;
		};
	};
};

/* Little cluster (A55): AXP318 DCDC5 */
&cpu0 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu1 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu2 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu3 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu4 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu5 {
	cpu-supply = <&reg_dcdc5>;
};

/* Big cluster (A76): AXP318 DCDC3 */
&cpu6 {
	cpu-supply = <&reg_dcdc3>;
};

&cpu7 {
	cpu-supply = <&reg_dcdc3>;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};

&pwm0_0 {
	pinctrl-0 = <&pwm0_0_active>;
    pinctrl-1 = <&pwm0_0_sleep>;
    status = "okay";
};

&hwspinlock {
	status = "okay";
};

/*
 * Hardware MSGBOX (ARM local_id=0 <-> CPUS).
 * Channel index = local_n * channels_max + P; channels 0..3 are ARM->CPUS.
 */
&msgbox {
	status = "okay";
};

/*
 * Isolated AMP remoteproc on cpu7 + rpmsg virtio, kicked via HW msgbox.
 * Start manually via sysfs when firmware is ready:
 *   echo start > /sys/class/remoteproc/remoteproc0/state
 * Add "auto-boot;" below once bootloader/kernel mem-fw path is verified.
 */
&a55_rproc {
	firmware-name = "amp_rproc";
	memory-region = <&a55_vdev0buffer>, <&a55_vdev0vring0>,
			<&a55_vdev0vring1>, <&a55_reserved>;
	boot-amp = <&amp0>;
	fw-region = <&a55_mem_fw>;
	mboxes = <&msgbox 0>;
	mbox-names = "arm-kick";
	core-id = <7>;
	memory-mappings =
		/* da          len          pa */
		< 0x40000000  0x40000000  0x40000000 >;
	status = "okay";
};

&spi0 {
    status = "okay";
};

&rtc {
    status = "okay";
};

&ufs {
	status = "okay";
	/* force-auto-pll-cal; */
};

/*
 * Bind USB to IOMMU master 0 with translation enabled (cell1 = 1).
 */
&mmu_aw {
	status = "okay";

	usb_iommu {
		iommu-master;
		id = <0>;
	};

	dummy04 {
		iommu-master;
		id = <4>;
		skip;
	};

	dummy05 {
		iommu-master;
		id = <5>;
		skip;
	};
};

&usbphy {
	status = "okay";
};

&ehci0 {
	status = "okay";
	iommus = <&mmu_aw 0 1>;
};

&ohci0 {
	status = "okay";
	iommus = <&mmu_aw 0 1>;
};

&gpadc0 {
	status = "okay";
};

&lradc {
	status = "okay";
	key_debounce;
	debounce_value = <50>;
	key_cnt = <1>;
	key0 = <500 116>; /* voltage(mV), KEY_POWER — adjust per schematic */
	filter-cnt = <3>;
};

&ths {
	status = "okay";
};

&irrx {
	status = "okay";
	ir_protocol_used = <0>; /* NEC */
	linux,rc-map-name = "rc-map-sunxi";
};

&codec {
	status = "okay";
};

&dmic {
	pinctrl-names = "default";
	pinctrl-0 = <&dmic_pins>;
	status = "okay";
};

&i2s0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0_mclk_pin &i2s0_bclk_pin &i2s0_lrck_pin
		     &i2s0_dout0_pin &i2s0_din0_pin>;
	status = "okay";
};

&gpu {
	status = "okay";
};
