#include "sun60i-a733.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "allwinner,a733-demo-aiot", "allwinner,a733";
	model = "Allwinner A733 Demo AIOT";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_5v: regulator-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "VCC5V0_SYS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	reg_3v3: regulator-fixed-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	sound_i2s0: sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sunxi-i2s0";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&sound_i2s0_cpu>;
		simple-audio-card,frame-master = <&sound_i2s0_cpu>;
		simple-audio-card,mclk-fs = <256>;

		sound_i2s0_cpu: simple-audio-card,cpu {
			sound-dai = <&i2s0>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec>;
		};
	};

	dmic_codec: dmic-codec {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <2>;
	};

	sound_dmic: sound-dmic {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sunxi-dmic";

		simple-audio-card,cpu {
			sound-dai = <&dmic>;
		};

		simple-audio-card,codec {
			sound-dai = <&dmic_codec>;
		};
	};
};

&pio {
	uart0_pins: uart0_pins {
		pins = "PB9", "PB10";
		function = "uart0";
		drive-strength = <10>;
	};
};

&r_pio {
	s_i2c0_pins: s_i2c0_pins {
		pins = "PL0", "PL1";
		function = "s_twi0";
		drive-strength = <10>;
	};
};

&s_i2c0 {
	pinctrl-0 = <&s_i2c0_pins>;
	pinctrl-names = "default";
	status = "okay";

	axp318: pmic@36 {
		compatible = "x-powers,axp318w";
		reg = <0x36>;
		#interrupt-cells = <1>;
		interrupt-controller;

		vin19-supply = <&reg_5v>;
		vin23-supply = <&reg_5v>;
		vin45-supply = <&reg_5v>;
		vin678-supply = <&reg_5v>;
		dldoin-supply = <&reg_5v>;
		cldoin-supply = <&reg_5v>;
		swin-supply = <&reg_5v>;

		regulators {
			/* System fabric */
			reg_dcdc2: dcdc2 {
				regulator-name = "vdd-sys";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* A76 / big cluster */
			reg_dcdc3: dcdc3 {
				regulator-name = "vdd-cpub";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <25000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* A55 / little cluster */
			reg_dcdc5: dcdc5 {
				regulator-name = "vdd-cpul";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1100000>;
				regulator-ramp-delay = <25000>;
				regulator-boot-on;
				regulator-always-on;
			};

			cldo5: cldo5 {
				regulator-name = "cldo5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			swout2: swout2 {
				regulator-name = "swout2";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			dcdc8: dcdc8 {
				regulator-name = "dcdc8";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			dldo6: dldo6 {
				regulator-name = "dldo6";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <2500000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

/* Little cluster (A55): AXP318 DCDC5 */
&cpu0 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu1 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu2 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu3 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu4 {
	cpu-supply = <&reg_dcdc5>;
};

&cpu5 {
	cpu-supply = <&reg_dcdc5>;
};

/* Big cluster (A76): AXP318 DCDC3 */
&cpu6 {
	cpu-supply = <&reg_dcdc3>;
};

&cpu7 {
	cpu-supply = <&reg_dcdc3>;
};

&mmc0 {
	/* Missing v(q)mmc-supply which is SWOUT2/CLDO3 of AXP318 */
	bus-width = <4>;
	disable-wp;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&swout2>;
	vqmmc-supply = <&cldo5>;
	status = "okay";
};

&uart0 {
	status = "okay";
};

/*
 * Bind USB to IOMMU master 0 with translation enabled (cell1 = 1).
 */
&mmu_aw {
	status = "okay";

	usb_iommu {
		iommu-master;
		id = <0>;
	};

	dummy04 {
		iommu-master;
		id = <4>;
		skip;
	};

	dummy05 {
		iommu-master;
		id = <5>;
		skip;
	};
};

&usbphy {
	status = "okay";
};

&ehci0 {
	status = "okay";
	iommus = <&mmu_aw 0 1>;
};

&ohci0 {
	status = "okay";
	iommus = <&mmu_aw 0 1>;
};

&gpadc0 {
	status = "okay";
};

&lradc {
	status = "okay";
	key_debounce;
	debounce_value = <50>;
	key_cnt = <1>;
	key0 = <500 116>; /* voltage(mV), KEY_POWER — adjust per schematic */
	filter-cnt = <3>;
};

&ths {
	status = "okay";
};

&irrx {
	status = "okay";
	ir_protocol_used = <0>; /* NEC */
	linux,rc-map-name = "rc-map-sunxi";
};

&codec {
	status = "okay";
};

&dmic {
	pinctrl-names = "default";
	pinctrl-0 = <&dmic_pins>;
	status = "okay";
};

&i2s0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s0_mclk_pin &i2s0_bclk_pin &i2s0_lrck_pin
		     &i2s0_dout0_pin &i2s0_din0_pin>;
	status = "okay";
};

/*
 * MIPI-CSI / sun60i VIN
 * ---------------------
 * SoC nodes live in sun60i-a733-vin.dtsi (vind0, mipi0, csi0, isp, vinc00).
 * Driver: drivers/media/platform/sunxi/sun60i-vin (CONFIG_VIDEO_SUN60I_VIN).
 * Enable a sensor on the board I2C bus and override &sensor0, for example:
 *
 *   &sensor0 {
 *       sensor0_mname = "gc2053_mipi";
 *       sensor0_twi_cci_id = <2>;
 *       sensor0_twi_addr = <0x6e>;
 *       sensor0_mclk_id = <0>;
 *       sensor0_iovdd-supply = <&reg_aldo1>;
 *       sensor0_avdd-supply = <&reg_aldo1>;
 *       sensor0_dvdd-supply = <&reg_dldo1>;
 *       sensor0_reset = <&pio PE 1 GPIO_ACTIVE_LOW>;
 *       sensor0_pwdn = <&pio PE 2 GPIO_ACTIVE_LOW>;
 *       status = "okay";
 *   };
 *
 * Also enable CONFIG_SENSOR_<NAME> in the kernel and rebuild.
 * Default pipeline: MIPI0 (PK0-PK9) -> CSI0 -> ISP0 -> vinc00 (/dev/video0).
 */
&vind0 {
	status = "okay";
};

&mipi0 {
	status = "okay";
};

&csi0 {
	status = "okay";
};

&vinc00 {
	status = "okay";
};
